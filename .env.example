# AgentCoop environment (MASTER-PLAN §3.9). Copy to .env; .env is gitignored and never committed.
# Server wallet keys: generate with `npx tsx scripts/keygen.ts --only-missing >> .env`
# (keys go to .env only: never paste them into chat, logs, screenshots or commits).

NETWORK=main
ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
OVERLAY_URL=http://localhost:8080
COOP_API_URL=http://localhost:8090
GUARD_URL=http://localhost:8091
PROVIDER_API_URL=http://localhost:8092

# server wallets (64 hex each; scripts/keygen.ts; NEVER commit)
WALLET_PROVIDER_API_KEY=
WALLET_COORDINATOR_KEY=
WALLET_GUARD_KEY=
WALLET_AGENT_1_KEY=
WALLET_AGENT_2_KEY=
WALLET_AGENT_3_KEY=
WALLET_MAKER_KEY=

# overlay + coordinator (Track B; infra/run.mjs and the services' READMEs)
OVERLAY_PORT=8080
COOP_PORT=8090
# overlay node key (64 hex, secret): leave empty and infra/run.mjs creates data/overlay/overlay.key (mode 600)
OVERLAY_PRIVATE_KEY=
TOKEN_WHITELIST=
ROUND_TIMEOUT_MS=60000
MAX_ROUNDS=3
# woc | none
SPENT_CHECK=woc

# originator for CLIs that connect to BSV Desktop (canonical DNS hostname)
APP_ORIGINATOR=agentcoop.local

# agent brain: llm | rules (rules works without an API key)
ANTHROPIC_API_KEY=
AGENT_BRAIN=rules

# Coop Rail PoC
# Base Sepolia RPC (empty = https://sepolia.base.org); maker / deployer key; agent's EVM key (tests and the live swap)
BASE_RPC_URL=
BASE_PRIVATE_KEY=
BASE_AGENT_PRIVATE_KEY=
BASE_USDC_ADDRESS=
# written by `npm run deploy -w @agentcoop/maker`
BASE_HTLC_ADDRESS=
# maker (apps/maker): HTTP for /quote and /events; fixed PoC rate, sats per whole USDC
MAKER_URL=http://localhost:8094
RAIL_SATS_PER_USDC=

# optional: where wallets, ledgers and logs go (default <repo>/data; read by infra/run.mjs and
# @agentcoop/core/node/env dataDir(), i.e. Track C's apps). D's scripts/ and apps/guard always use <repo>/data
DATA_DIR=

# guard (D.P2): CORS origin for the browser console (Track E); default *
GUARD_CORS_ORIGIN=

# agent event stream (Track C; MASTER §3.10)
AGENTS_URL=http://localhost:8093

# frontend (apps/web, Vite build-time; public URLs only, no secrets)
VITE_COOP_API_URL=http://localhost:8090
VITE_OVERLAY_URL=http://localhost:8080
VITE_PROVIDER_API_URL=http://localhost:8092
VITE_GUARD_URL=http://localhost:8091
VITE_AGENTS_URL=http://localhost:8093
VITE_ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
VITE_NETWORK=main
VITE_DATA_MODE=live
# Track C: run an agent in Mandate Vault mode (vault created + funded with owner-cli, adopted by the agent)
FINETUNE_VAULT_ID=
AGENTS_URL=http://localhost:8093
