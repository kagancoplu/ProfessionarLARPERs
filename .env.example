# MASTER-PLAN §3.9. Copy to .env (gitignored) and fill in. Track D owns this file.
NETWORK=main
ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
OVERLAY_URL=http://localhost:8080
COOP_API_URL=http://localhost:8090
GUARD_URL=http://localhost:8091
PROVIDER_API_URL=http://localhost:8092
# Server wallets (64 hex; scripts/keygen.ts generates them; NEVER commit)
WALLET_PROVIDER_API_KEY=
WALLET_COORDINATOR_KEY=
WALLET_GUARD_KEY=
WALLET_AGENT_1_KEY=
WALLET_AGENT_2_KEY=
WALLET_AGENT_3_KEY=
WALLET_MAKER_KEY=
# Originator for CLIs that connect to BSV Desktop
APP_ORIGINATOR=agentcoop.local
# Agent brain
ANTHROPIC_API_KEY=
AGENT_BRAIN=rules
# Rail PoC
BASE_RPC_URL=
BASE_PRIVATE_KEY=
BASE_USDC_ADDRESS=
# Optional: where wallets, ledgers and logs go (default ./data)
DATA_DIR=
