{
  "name": "@agentcoop/coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentCoop coordinator and side API: offers, pools, pledges, WS feed (later: lock-in, signing rounds, broadcast). Holds no funds.",
  "exports": {
    "./client": "./src/client.ts",
    "./auth": "./src/auth.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "coordinator": "tsx --import @agentcoop/core/register-sdk src/server.ts",
    "test": "cd ../.. && vitest run apps/coordinator",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentcoop/core": "0.1.0",
    "@bsv/sdk": "3.2.1",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "knex": "3.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@bsv/overlay": "2.6.4",
    "@bsv/overlay-express": "2.7.4",
    "@bsv/wallet-toolbox": "2.14.9",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
