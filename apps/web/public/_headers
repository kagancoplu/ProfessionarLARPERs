# Cloudflare Pages headers (track-E Faz 4.5). Service origins: fill in the public URLs of the coordinator,
# overlay, provider-api, guard, agents and maker before deploying (connect-src).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://arcade-v2-us-1.bsvblockchain.tech https://api.whatsonchain.com wss: https: http://localhost:3301 http://localhost:3321; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'

/game/*
  Cache-Control: public, max-age=31536000, immutable

/ui/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/replays/*
  Cache-Control: public, max-age=3600
