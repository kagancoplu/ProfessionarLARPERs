{
  "name": "@agentcoop/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentCoop frontend: role consoles + pixel-art live town. Browser \u2192 BSV Desktop (WalletClient), services via REST/WS/SSE.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sprites": "tsx tools/sprites.mjs",
    "px": "tsx tools/px.mjs",
    "record:mock": "tsx tools/record-mock.mjs"
  },
  "dependencies": {
    "@agentcoop/core": "0.1.0",
    "@bsv/sdk": "3.2.1",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "howler": "2.2.4",
    "msw": "2.15.0",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/howler": "2.2.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "free-tex-packer-core": "0.3.9",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
