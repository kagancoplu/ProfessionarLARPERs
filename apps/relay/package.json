{
  "name": "@agentcoop/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentCoop relay: mirrors the services' streams and snapshots into Supabase for the web's live layer. Holds no keys of value; optional.",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "test": "cd ../.. && vitest run apps/relay"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
