{
  "name": "@agentcoop/overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentCoop overlay: tm_agentcoop + ls_agentcoop (BSV-21 credit rules from the kit + AgentCoop records)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "overlay": "tsx src/server.ts",
    "test": "cd ../.. && vitest run packages/overlay",
    "typecheck": "tsc --noEmit",
    "arcade-policy": "tsx scripts/arcadePolicy.ts"
  },
  "dependencies": {
    "@agentcoop/core": "0.1.0",
    "@bsv/overlay": "2.6.4",
    "@bsv/overlay-express": "2.7.4",
    "@bsv/sdk": "3.2.1",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "knex": "3.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "@bsv/wallet-toolbox": "2.14.9"
  }
}
