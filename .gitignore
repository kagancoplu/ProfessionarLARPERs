# Created early by Track D (ops) so server wallet keys are protected before A.P0;
# merged with Track A's root .gitignore. Extend this file, do not drop the secret/data rules.

# dependencies and build output
node_modules/
dist/
coverage/
graft/

# secrets: server wallet keys, API keys (.env.example is committed)
.env
.env.*
!.env.example

# wallet databases, overlay db, payment hand-off files, guard ledger
data/
*.sqlite
*.sqlite-*
*.sqlite3
*.db
*.db-*

# EVM tooling (Coop Rail)
contracts/**/out/
contracts/**/cache/
contracts/**/broadcast/

# frontend (apps/web) build and tooling caches
apps/web/dist/
apps/web/.vite/
apps/web/playwright-report/
apps/web/test-results/
# film mode renders (tools/film-render.mjs)
apps/web/film-out/

.DS_Store
backups/

# raw third-party art packs (apps/web): licenses forbid redistribution; only processed atlases are committed
apps/web/assets/packs/

# Runtime data written to the repo root when DATA_DIR was empty (fixed in 8ad4e6e).
# /overlay/overlay.key is a private key: never commit these.
/overlay/
/agents/
/provider-cli/
