# AgentCoop public edge (B-P5a). Caddy gets and renews Let's Encrypt certificates
# by itself and redirects HTTP to HTTPS. Hosts come from /etc/agentcoop.env:
#   OVERLAY_HOST=overlay.example.org   COOP_HOST=coop.example.org
# No domain yet: use <server-ip>.sslip.io names (no DNS needed), e.g.
#   OVERLAY_HOST=overlay.203-0-113-7.sslip.io   COOP_HOST=coop.203-0-113-7.sslip.io
{
	email {$ACME_EMAIL:admin@localhost}
}

{$OVERLAY_HOST} {
	encode gzip
	# SSE (/agentcoop/events) must not be buffered.
	reverse_proxy 127.0.0.1:{$OVERLAY_PORT:8080} {
		flush_interval -1
	}
	log {
		output file /var/log/caddy/overlay.log
	}
}

{$COOP_HOST} {
	encode gzip
	# WebSocket upgrade on /ws is proxied as is.
	reverse_proxy 127.0.0.1:{$COOP_PORT:8090}
	log {
		output file /var/log/caddy/coop.log
	}
}

# Single-box live demo (FULL_STACK=1): guard, provider-api and agents.
# Each serves SSE on /events, so the proxy must not buffer (flush_interval -1).
# Set GUARD_HOST/PROVIDER_HOST/AGENTS_HOST in /etc/agentcoop.env; a host left
# empty is served on :80/:443 for the empty name, so leave the block's env unset
# to disable it (Caddy ignores an empty site address).
{$GUARD_HOST} {
	encode gzip
	reverse_proxy 127.0.0.1:{$GUARD_PORT:8091} {
		flush_interval -1
	}
	log {
		output file /var/log/caddy/guard.log
	}
}

{$PROVIDER_HOST} {
	encode gzip
	reverse_proxy 127.0.0.1:{$PROVIDER_PORT:8092} {
		flush_interval -1
	}
	log {
		output file /var/log/caddy/provider.log
	}
}

{$AGENTS_HOST} {
	encode gzip
	reverse_proxy 127.0.0.1:{$AGENTS_PORT:8093} {
		flush_interval -1
	}
	log {
		output file /var/log/caddy/agents.log
	}
}

# Second, independent coordinator (Faz 6.2; COOP2_PORT=8094 in /etc/agentcoop.env).
