# Server env for the public overlay + coordinator (B-P5a). Copy to
# /etc/agentcoop.env (owner root, mode 600). Never commit the real file.
NETWORK=main
ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
# Caddy hosts (infra/Caddyfile). No domain: <ip-with-dashes>.sslip.io
OVERLAY_HOST=overlay.example.org
COOP_HOST=coop.example.org
ACME_EMAIL=
OVERLAY_PORT=8080
COOP_PORT=8090
# Optional second, independent coordinator on the same overlay (Faz 6.2): own DB; uncomment the COOP2 block in the Caddyfile
# COOP2_PORT=8094
# COOP2_HOST=coop2.example.org

# ── Single-box live demo (FULL_STACK=1): also run guard, provider-api and agents here ──
# Needs the server-wallet keys below and, for the LLM agents, an API key. Caddy
# exposes each over HTTPS at the host names set here (Caddyfile guard/provider/agents blocks).
FULL_STACK=1
GUARD_HOST=guard.example.org
PROVIDER_HOST=provider.example.org
AGENTS_HOST=agents.example.org
GUARD_PORT=8091
PROVIDER_PORT=8092
AGENTS_PORT=8093
# Server wallet private keys (64 hex each; never commit the real file)
WALLET_COORDINATOR_KEY=
WALLET_GUARD_KEY=
WALLET_PROVIDER_API_KEY=
WALLET_AGENT_1_KEY=
WALLET_AGENT_2_KEY=
WALLET_AGENT_3_KEY=
# Agent brain: openai | llm | rules
AGENT_BRAIN=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=            # only if AGENT_BRAIN=llm
# Supabase live mirror for the web (also starts apps/relay). Secret key bypasses RLS: keep it here only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Overlay node key (64 hex). Empty: generated once into $DATA_DIR/overlay/overlay.key (600)
OVERLAY_PRIVATE_KEY=
# Optional: only these credit token ids (comma-separated)
TOKEN_WHITELIST=
# Signing rounds (MASTER §3.2)
ROUND_TIMEOUT_MS=60000
MAX_ROUNDS=3
SPENT_CHECK=woc
# Edge limits per client IP (defaults shown; RATE_LIMIT=off disables HTTP limits)
RATE_LIMIT=on
RATE_GET_PER_MIN=120
RATE_POST_PER_MIN=10
OVERLAY_RATE_LOOKUP_PER_MIN=60
OVERLAY_RATE_SUBMIT_PER_MIN=30
WS_MAX_PER_IP=20
WS_MAX_CLIENTS=1000
WS_MAX_MSGS_PER_10S=40
# Backups (infra/backup.mjs): where and how many days
BACKUP_DIR=/var/backups/agentcoop
BACKUP_KEEP_DAYS=7
